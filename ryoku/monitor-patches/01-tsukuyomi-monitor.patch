+	for _, vp := range vendors {
+		v := strings.TrimSpace(readString(vp))
+		if v != "0x10de" {
+			continue
+		}
+		cls := strings.TrimSpace(readString(filepath.Join(filepath.Dir(vp), "class")))
+		if !strings.HasPrefix(cls, "0x03") {
+			continue
+		}
+		found = true
+		st := strings.TrimSpace(readString(filepath.Join(filepath.Dir(vp), "power/runtime_status")))
+		if st != "suspended" {
+			return false
+		}
+	}
+	return found
+}
