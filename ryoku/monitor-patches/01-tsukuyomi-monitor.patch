+func interfaceIPs(name string) ([]string, []string) {
+	v4, v6 := []string{}, []string{}
+	iface, err := net.InterfaceByName(name)
+	if err != nil {
+		return v4, v6
+	}
+	addrs, err := iface.Addrs()
+	if err != nil {
+		return v4, v6
+	}
+	for _, a := range addrs {
