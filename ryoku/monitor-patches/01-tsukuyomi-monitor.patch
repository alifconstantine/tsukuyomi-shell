+func resolveBlockRoot(dev string) string {
+	realDev := dev
+	if resolved, err := filepath.EvalSymlinks(dev); err == nil && resolved != "" {
+		realDev = resolved
+	}
+	base := filepath.Base(realDev)
+	if _, err := os.Stat(filepath.Join("/sys/block", base)); err == nil {
+		return base
+	}
+	if matches, _ := filepath.Glob(filepath.Join("/sys/block", "*", base)); len(matches) > 0 {
+		return filepath.Base(filepath.Dir(matches[0]))
