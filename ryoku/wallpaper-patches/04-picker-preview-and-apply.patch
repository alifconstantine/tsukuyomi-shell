--- /dev/null
+++ b/SelectionPreview.qml
@@ -0,0 +1,108 @@
+import QtQuick
+import QtQuick.Controls
+import Ryoku.Ui.Singletons
+
+FocusScope {
+    id: root
+
+    property PickerState state
+    readonly property var entry: state && state.previewEntry ? state.previewEntry : ({})
+    readonly property bool themePreview: state && state.sheetArgs.collection === "themes"
+    property var loadedPalette: null
+    readonly property var palette: entry.palette || Theme.presets[entry.key] || loadedPalette
+
+    function loadThemePalette() {
+        if (!themePreview || palette || art)
+            return
+        var key = entry.key
+        Daemon.call("theme.previews", {}, function(result, error) {
+            if (!error && result && root.entry.key === key) {
+                var card = (result.previews || []).find(preview => preview.value === key)
+                root.loadedPalette = card ? card.palette : null
+            }
+        })
+    }
+
+    onStateChanged: loadThemePalette()
+    readonly property string art: String(entry.preview || entry.thumb
+        || (entry.type === "static" ? entry.path : "") || "")
+
+    Keys.onEscapePressed: if (state) state.closeSheet()
+
+    Rectangle {
+        anchors.fill: parent
+        color: "#a6000000"
+        TapHandler { onTapped: if (root.state) root.state.closeSheet() }
+    }
+
+    Rectangle {
+        id: panel
+        width: Math.min(parent.width * 0.88, Theme.px(760))
+        height: Math.min(parent.height * 0.80, width * 0.70)
+        anchors.centerIn: parent
+        color: Theme.surface
+        border.color: Theme.outline
+        radius: Theme.radius
+        MouseArea { anchors.fill: parent }
+
+        Text {
+            anchors { left: parent.left; right: closeButton.left; top: parent.top; margins: Theme.px(16) }
+            text: String(root.entry.name || root.entry.key || "")
+            color: Theme.surfaceText
+            font.family: Theme.sans
+            font.pixelSize: Theme.fontHead
+            font.weight: Font.DemiBold
+            elide: Text.ElideRight
+        }
+
+        Button {
+            id: closeButton
+            anchors { top: parent.top; right: parent.right; margins: Theme.px(12) }
+            text: I18n.tr("Close")
+            focus: true
+            onClicked: if (root.state) root.state.closeSheet()
+        }
+
+        Item {
+            id: content
+            anchors {
+                top: closeButton.bottom; bottom: parent.bottom
+                left: parent.left; right: parent.right; margins: Theme.px(16)
+            }
+            Image {
+                id: picture
+                anchors.fill: parent
+                source: root.art ? Library.fileUrl(root.art) : ""
+                visible: status === Image.Ready
+                asynchronous: true
+                sourceSize.width: Math.ceil(width)
+                sourceSize.height: Math.ceil(height)
+                fillMode: Image.PreserveAspectFit
+            }
+            Row {
+                anchors.centerIn: parent
+                spacing: Theme.px(8)
+                visible: picture.status !== Image.Ready && root.themePreview && !!root.palette
+                Repeater {
+                    model: ["surface", "surfaceText", "primary", "tertiary", "outline"]
+                    Rectangle {
+                        required property string modelData
+                        width: Math.min(content.width / 7, Theme.px(76))
+                        height: width
+                        radius: Theme.radius
+                        border.color: Theme.outline
+                        color: root.palette && root.palette[modelData] || Theme[modelData]
+                    }
+                }
+            }
+            Text {
+                anchors.centerIn: parent
+                visible: picture.status !== Image.Ready && !(root.themePreview && root.palette)
+                text: picture.status === Image.Loading ? I18n.tr("Loading preview…") : I18n.tr("Preview unavailable")
+                color: Theme.surfaceText
+                font.family: Theme.sans
+                font.pixelSize: Theme.fontBody
+            }
+        }
+    }
+}
