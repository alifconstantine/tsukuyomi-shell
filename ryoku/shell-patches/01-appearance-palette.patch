+++ b/tsukuyomi_appearance_test.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"testing"
+)
+
+func TestAppearanceSelectsDefaultAndSignalsPaletteRefresh(t *testing.T) {
+	cfg := t.TempDir()
+	t.Setenv("XDG_CONFIG_HOME", cfg)
+	store := newSettingsStore(filepath.Join(cfg, "shell.json"))
+	if err := store.patch("theme.theme", json.RawMessage(`"Dracula"`)); err != nil {
+		t.Fatal(err)
+	}
+	before := matugenThemeSig(store.frameLocked())
+	if err := store.patch("theme.appearance", json.RawMessage(`{"mode":"light","accent":"custom","hex":"#407ACA"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if store.cur.Theme.Theme != "Default" || store.cur.Theme.Appearance.Mode != "light" {
+		t.Fatalf("unexpected theme: %+v", store.cur.Theme)
+	}
+	after := matugenThemeSig(store.frameLocked())
+	if before == after {
+		t.Fatal("appearance change didn't invalidate the palette")
+	}
+	if err := store.patch("theme.appearance", json.RawMessage(`{"mode":"dark","accent":"custom","hex":"invalid"}`)); err == nil {
+		t.Fatal("invalid colour was accepted")
+	}
+	if got := matugenThemeSig(store.frameLocked()); got != after {
+		t.Fatalf("invalid change modified settings: %s", got)
+	}
+}
+
+func TestAppearanceLeavesAccentRolesColoured(t *testing.T) {
+	palette := map[string]string{"surface": "#131629", "primary": "#6699cc", "error": "#cc1111"}
+	neutralizeAppearanceSurfaces(palette)
+	if palette["surface"] == "#131629" || palette["primary"] != "#6699cc" || palette["error"] != "#cc1111" {
+		t.Fatalf("unexpected palette: %v", palette)
+	}
+}
