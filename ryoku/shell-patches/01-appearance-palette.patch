@@ -0,0 +1,65 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// The Default theme has independent brightness and accent choices. Named Store
+// themes continue to supply their own palette through the existing catalog.
+type appearanceSettings struct {
+	Mode   string `json:"mode"`
+	Accent string `json:"accent"`
+	Hex    string `json:"hex,omitempty"`
+}
+
+func (a appearanceSettings) validate() error {
+	switch a.Mode {
+	case "dark", "light", "auto":
+	default:
+		return fmt.Errorf("appearance: choose dark, light, or auto")
+	}
+	switch a.Accent {
+	case "neutral", "wallpaper":
+		return nil
+	case "preset", "custom":
+		if len(a.Hex) == 7 && a.Hex[0] == '#' {
+			if _, _, _, ok := parseHexRGB(a.Hex); ok {
+				return nil
+			}
+		}
+	}
+	return fmt.Errorf("appearance: choose an accent or enter a valid #RRGGBB colour")
+}
+
+func activeAppearance() *appearanceSettings {
+	raw, err := os.ReadFile(filepath.Join(ryokuConfigDir(), "shell.json"))
+	if err != nil {
+		return nil
+	}
+	var config struct {
+		Theme themeSettings `json:"theme"`
+	}
+	if json.Unmarshal(raw, &config) != nil || config.Theme.Theme != "Default" {
+		return nil
+	}
+	a := config.Theme.Appearance
+	if a == nil || a.validate() != nil {
+		return nil
+	}
+	return a
+}
+
+func neutralizeAppearanceSurfaces(palette map[string]string) {
+	for role, hex := range palette {
+		switch {
+		case strings.HasPrefix(role, "surface"), strings.HasPrefix(role, "on_surface"),
+			strings.HasPrefix(role, "outline"), role == "background", role == "on_background",
+			role == "inverse_surface", role == "inverse_on_surface":
+			palette[role] = neutralizeHex(hex)
+		}
+	}
+}
