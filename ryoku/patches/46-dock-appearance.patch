--- /dev/null
+++ b/hub/pages/DockPage.qml
@@ -0,0 +1,105 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Ryoku.Ui
+import Ryoku.Ui.Singletons
+import ".."
+import "../Singletons"
+
+Item {
+    id: page
+
+    property var hub
+    readonly property bool fullBleed: true
+    readonly property bool dockShown: Settings.get("dock.enabled") === true
+    property bool saving: false
+    property string errorMessage: ""
+
+    function updateSetting(key, value) {
+        if (!Settings.ready || saving)
+            return;
+        page.saving = true;
+        page.errorMessage = "";
+        Settings.patch("dock." + key, value, function(ok, error) {
+            page.saving = false;
+            if (!ok)
+                page.errorMessage = error || I18n.tr("Could not save the dock setting.");
+        });
+    }
+
+    SchemaPage {
+        anchors.fill: parent
+        anchors.margins: Tokens.s6
+        schema: []
+        draft: null
+        defaults: ({})
+        title: I18n.tr("Dock")
+        blurb: I18n.tr("Choose when the desktop dock appears.")
+
+        Column {
+            width: parent.width
+            spacing: Tokens.s4
+
+            SettingCard {
+                width: parent.width
+                title: I18n.tr("Visibility")
+                collapsible: false
+
+                SettingRow {
+                    width: parent.width
+                    label: I18n.tr("Show dock")
+                    controlWidth: 55
+
+                    Sw {
+                        objectName: "showDesktopDock"
+                        anchors.right: parent.right
+                        anchors.verticalCenter: parent.verticalCenter
+                        on: page.dockShown
+                        enabled: Settings.ready && !page.saving
+                        Accessible.role: Accessible.CheckBox
+                        Accessible.name: I18n.tr("Show dock")
+                        Accessible.checked: on
+                        Accessible.onToggleAction: activate()
+                        onToggled: value => page.updateSetting("enabled", value)
+                    }
+                }
+
+                SettingRow {
+                    width: parent.width
+                    label: I18n.tr("Auto-hide")
+                    desc: I18n.tr("Reveal the dock by moving the pointer to its screen edge.")
+                    divider: true
+                    controlWidth: 55
+
+                    Sw {
+                        anchors.right: parent.right
+                        anchors.verticalCenter: parent.verticalCenter
+                        on: Settings.get("dock.autohide") === true
+                        enabled: Settings.ready && !page.saving && page.dockShown
+                        Accessible.role: Accessible.CheckBox
+                        Accessible.name: I18n.tr("Auto-hide")
+                        Accessible.checked: on
+                        Accessible.onToggleAction: activate()
+                        onToggled: value => page.updateSetting("autohide", value)
+                    }
+                }
+            }
+
+            Text {
+                width: parent.width
+                visible: page.errorMessage !== ""
+                text: page.errorMessage
+                font.family: Tokens.ui
+                font.pixelSize: Tokens.fBody
+                color: Tokens.alert
+                wrapMode: Text.WordWrap
+            }
+
+            Btn {
+                text: I18n.tr("Customize dock")
+                onAct: Quickshell.execDetached(["qs", "-c", "shell", "ipc", "call", "desktop", "editSection", "dock", ""])
+            }
+        }
+    }
+}
