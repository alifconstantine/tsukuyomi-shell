--- /dev/null
+++ b/hub/pages/QsBarStudio.qml
@@ -0,0 +1,266 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC
+import Quickshell
+import Quickshell.Io
+import Ryoku.Ui
+import Ryoku.Ui.Singletons
+import "../Singletons"
+import "../tsukuyomi" as Tsukuyomi
+
+Column {
+    id: editor
+
+    property string tab: "bars"
+    property string selectedId: ""
+    property var widgets: []
+    property string errorMessage: ""
+    property bool saving: false
+    readonly property bool barActive: Settings.ready && Settings.get("barStyle") === "qsbar"
+    readonly property string qsConfig: JSON.stringify(Settings.get("qsbar") || ({}))
+    readonly property var selected: widgets.find(widget => widget.id === selectedId) || null
+    readonly property var lanes: [
+        { name: I18n.tr("Left"), id: "left" }, { name: I18n.tr("Center"), id: "center" },
+        { name: I18n.tr("Right"), id: "right" }
+    ]
+    readonly property var forms: [
+        { name: I18n.tr("Islands"), id: "islands" }, { name: I18n.tr("Full width"), id: "full" },
+        { name: I18n.tr("Fit"), id: "fit" }, { name: I18n.tr("Dock"), id: "dock" },
+        { name: I18n.tr("Notch"), id: "notch" }
+    ]
+
+    spacing: Tokens.s4
+
+    function loadWidgets() {
+        if (editor.visible && editor.barActive && !readWidgets.running)
+            readWidgets.running = true;
+    }
+    function patch(key, value) {
+        if (!barActive || saving)
+            return;
+        editor.saving = true;
+        editor.errorMessage = "";
+        Settings.patch("qsbar." + key, value, (ok, error) => {
+            editor.saving = false;
+            if (!ok)
+                editor.errorMessage = error || I18n.tr("The bar settings could not be saved.");
+        });
+    }
+    function run(args) {
+        if (!barActive || saving)
+            return;
+        editor.errorMessage = "";
+        editor.saving = true;
+        runBar.command = ["ryoku-shell", "bar"].concat(args);
+        runBar.running = true;
+    }
+    function move(lane, index) {
+        if (!editor.selected)
+            return;
+        const args = ["move", editor.selected.id, "--section", lane];
+        if (index >= 0)
+            args.push("--index", String(index));
+        editor.run(args);
+    }
+    function openSettings() {
+        if (barActive)
+            Quickshell.execDetached(["ryoku-shell", "bar", "settings", editor.tab]);
+    }
+
+    onQsConfigChanged: refresh.restart()
+    onBarActiveChanged: if (barActive) refresh.restart()
+    onVisibleChanged: if (visible) refresh.restart()
+    Component.onCompleted: refresh.start()
+
+    Timer { id: refresh; interval: 70; onTriggered: editor.loadWidgets() }
+
+    Process {
+        id: readWidgets
+        command: ["ryoku-shell", "bar", "list", "--json"]
+        stdout: StdioCollector { id: widgetData }
+        onExited: code => {
+            if (code !== 0)
+                return;
+            try {
+                const list = JSON.parse(widgetData.text);
+                if (!Array.isArray(list))
+                    return;
+                editor.widgets = list;
+                if (!editor.selected)
+                    editor.selectedId = list.length ? list[0].id : "";
+            } catch (error) {
+                editor.errorMessage = I18n.tr("Could not read the bar layout.");
+            }
+        }
+    }
+    Process {
+        id: runBar
+        stdout: StdioCollector { id: barResult }
+        stderr: StdioCollector { id: barError }
+        onExited: code => {
+            editor.saving = false;
+            const reply = barResult.text.trim();
+            if (code !== 0 || reply.startsWith("err"))
+                editor.errorMessage = barError.text.trim() || reply || I18n.tr("Could not update the bar.");
+            refresh.restart();
+        }
+    }
+    FileView {
+        path: editor.visible ? (Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config")
+              + "/ryoku/plugins.json" : ""
+        watchChanges: editor.visible
+        printErrors: false
+        onFileChanged: { reload(); refresh.restart(); }
+    }
+
+    SettingCard {
+        width: parent.width
+        title: I18n.tr("QS Bar")
+        collapsible: false
+
+        Seg {
+            options: ["bars", "layout", "widgets", "dock"]
+            labels: ({ bars: I18n.tr("Style"), layout: I18n.tr("Layout"),
+                widgets: I18n.tr("Widgets"), dock: I18n.tr("Dock") })
+            current: editor.tab
+            onChose: value => editor.tab = value
+        }
+
+        SettingRow {
+            width: parent.width
+            visible: editor.tab === "bars"
+            label: I18n.tr("Bar form")
+            controlWidth: form.width
+            QQC.ComboBox {
+                id: form
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+                model: editor.forms
+                textRole: "name"
+                valueRole: "id"
+                currentIndex: Math.max(0, editor.forms.findIndex(item =>
+                    item.id === (Settings.get("qsbar.barShellStyle") || "full")))
+                enabled: editor.barActive && !editor.saving
+                onActivated: editor.patch("barShellStyle", currentValue)
+                Accessible.name: I18n.tr("Bar form")
+            }
+        }
+        SettingRow {
+            width: parent.width
+            visible: editor.tab === "bars"
+            label: I18n.tr("Position")
+            divider: true
+            controlWidth: position.implicitWidth
+            Seg {
+                id: position
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+                options: ["top", "bottom"]
+                labels: ({ top: I18n.tr("Top"), bottom: I18n.tr("Bottom") })
+                current: Settings.get("qsbar.barPosition") || "top"
+                enabled: editor.barActive && !editor.saving
+                onChose: value => editor.patch("barPosition", value)
+            }
+        }
+        SettingRow {
+            width: parent.width
+            visible: editor.tab === "bars"
+            label: I18n.tr("Frosted material")
+            divider: true
+            controlWidth: 55
+            Sw {
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+                on: Settings.get("qsbar.barFrostEnabled") === true
+                enabled: editor.barActive && !editor.saving
+                onToggled: value => editor.patch("barFrostEnabled", value)
+            }
+        }
+
+        SettingRow {
+            width: parent.width
+            visible: editor.tab === "layout" || editor.tab === "widgets"
+            label: I18n.tr("Widget")
+            controlWidth: widget.width
+            QQC.ComboBox {
+                id: widget
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+                width: Math.min(230, editor.width * 0.43)
+                model: editor.widgets
+                textRole: "label"
+                valueRole: "id"
+                currentIndex: Math.max(0, editor.widgets.findIndex(item => item.id === editor.selectedId))
+                enabled: editor.barActive && !editor.saving && count > 0
+                onActivated: editor.selectedId = currentValue
+                Accessible.name: I18n.tr("Bar widget")
+            }
+        }
+        SettingRow {
+            width: parent.width
+            visible: editor.tab === "layout" && editor.selected !== null
+            label: I18n.tr("Section")
+            divider: true
+            controlWidth: sectionChoice.implicitWidth
+            Seg {
+                id: sectionChoice
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+                options: editor.lanes.map(lane => lane.id)
+                labels: Object.fromEntries(editor.lanes.map(lane => [lane.id, lane.name]))
+                current: editor.selected ? editor.selected.section : ""
+                enabled: editor.barActive && !editor.saving
+                onChose: value => {
+                    if (value !== current)
+                        editor.move(value, -1);
+                }
+            }
+        }
+        Flow {
+            width: parent.width
+            visible: editor.tab === "layout" && editor.selected !== null
+            spacing: Tokens.s3
+            Btn {
+                text: I18n.tr("Move earlier")
+                enabled: editor.barActive && !editor.saving && editor.selected && editor.selected.index > 0
+                onAct: editor.move(editor.selected.section, editor.selected.index - 1)
+            }
+            Btn {
+                text: I18n.tr("Move later")
+                enabled: editor.barActive && !editor.saving && editor.selected && editor.widgets.some(widget =>
+                    widget.section === editor.selected.section && widget.index > editor.selected.index)
+                onAct: editor.move(editor.selected.section, editor.selected.index + 1)
+            }
+        }
+        SettingRow {
+            width: parent.width
+            visible: editor.tab === "widgets" && editor.selected !== null
+            label: I18n.tr("Show on bar")
+            divider: true
+            controlWidth: 55
+            Sw {
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+                on: editor.selected ? editor.selected.shown : false
+                enabled: editor.barActive && !editor.saving && editor.selected
+                    && !["launcher", "workspaces", "clock"].includes(editor.selected.id)
+                onToggled: value => editor.run([value ? "show" : "hide", editor.selected.id])
+            }
+        }
+
+        Text {
+            width: parent.width
+            visible: editor.errorMessage !== ""
+            color: Tokens.alert
+            font.family: Tokens.ui
+            wrapMode: Text.WordWrap
+            text: editor.errorMessage
+        }
+        Btn {
+            text: editor.tab === "dock" ? I18n.tr("Open dock settings") : I18n.tr("Open full QS Bar settings")
+            enabled: editor.barActive
+            onAct: editor.openSettings()
+        }
+    }
+}
