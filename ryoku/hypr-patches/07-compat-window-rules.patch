diff -ruN hypr/modules/binds.lua hypr_new/modules/binds.lua
--- a/modules/binds.lua	2026-11-12 08:10:35.000000000 +0700
+++ b/modules/binds.lua	2026-11-22 15:43:53.810776897 +0700
@@ -209,3 +209,6 @@
 hl.bind(K("XF86TouchpadToggle"), hl.dsp.exec_cmd("ryoku wm act input.touchpad toggle"), { locked = true }) -- toggle the touchpad
 hl.bind(K("XF86TouchpadOn"),     hl.dsp.exec_cmd("ryoku wm act input.touchpad on"),     { locked = true }) -- enable the touchpad
 hl.bind(K("XF86TouchpadOff"),    hl.dsp.exec_cmd("ryoku wm act input.touchpad off"),    { locked = true }) -- disable the touchpad
+
+-- Cycle Android viewport size preset when a Waydroid window is focused
+hl.bind(K("ALT + R"), hl.dsp.exec_cmd("/usr/lib/tsukuyomi/droid-cycle-resize"))
diff -ruN hypr/modules/window_rules.lua hypr_new/modules/window_rules.lua
--- a/modules/window_rules.lua	2026-11-22 15:42:47.663269320 +0700
+++ b/modules/window_rules.lua	2026-11-22 15:43:53.810711564 +0700
@@ -304,3 +304,28 @@
     workspace = "special:sharebar silent",
     no_focus  = true,
 })
+
+hl.window_rule({
+    name   = "float-tsukuyomi-compat-installer",
+    match  = { title = "^(Tsukuyomi (?:Windows|Android) Installer)$" },
+    float  = true,
+    size   = fit(580, 470),
+    center = true,
+})
+
+hl.window_rule({
+    name    = "float-waydroid-apps",
+    match   = { class = "^(waydroid\\..*|Waydroid)$" },
+    float   = true,
+    size    = { "min(450, monitor_w * 0.45)", "min(900, monitor_h * 0.86)" },
+    center  = true,
+    no_blur = true,
+    opaque  = true,
+})
+
+hl.window_rule({
+    name    = "compat-wine-apps",
+    match   = { class = "^(.*\\.exe|wine)$" },
+    no_blur = true,
+    opaque  = true,
+})
