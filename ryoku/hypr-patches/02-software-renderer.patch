--- a/modules/perf_saver.lua
+++ b/modules/perf_saver.lua
@@ -19,3 +19,18 @@
 if saver() then
   hl.config({ decoration = { blur = { enabled = false }, shadow = { enabled = false } } })
 end
+
+-- Per-compositor flag written by Tsukuyomi once the renderer log is available.
+local runtime = os.getenv("XDG_RUNTIME_DIR")
+local instance = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
+if runtime and instance then
+  local marker = io.open(runtime .. "/hypr/" .. instance .. "/tsukuyomi-software-renderer", "r")
+  if marker then
+    marker:close()
+    hl.config({ decoration = {
+      blur = { enabled = false },
+      shadow = { enabled = false },
+      inactive_opacity = 1.0,
+    } })
+  end
+end
