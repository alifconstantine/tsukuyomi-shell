--- a/modules/perf_saver.lua
+++ b/modules/perf_saver.lua
@@ -19,3 +19,31 @@
 if saver() then
   hl.config({ decoration = { blur = { enabled = false }, shadow = { enabled = false } } })
 end
+
+-- Detect software renderer either from session environment (available on frame 1)
+-- or from the per-compositor marker written by start-desktop once hyprland.log flushes.
+local function is_software_renderer()
+  if os.getenv("TSUKUYOMI_SOFTWARE_RENDERER") == "1" or os.getenv("LIBGL_ALWAYS_SOFTWARE") == "1" then
+    return true
+  end
+  local runtime = os.getenv("XDG_RUNTIME_DIR")
+  local instance = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
+  if runtime and instance then
+    local marker = io.open(runtime .. "/hypr/" .. instance .. "/tsukuyomi-software-renderer", "r")
+    if marker then
+      marker:close()
+      return true
+    end
+  end
+  return false
+end
+
+if is_software_renderer() then
+  hl.env("TSUKUYOMI_SOFTWARE_RENDERER", "1")
+  hl.config({ animations = { enabled = false }, decoration = {
+    blur = { enabled = false },
+    shadow = { enabled = false },
+    inactive_opacity = 1.0,
+    active_opacity = 1.0,
+  } })
+end
