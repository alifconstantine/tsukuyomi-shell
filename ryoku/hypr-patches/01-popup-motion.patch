+-- Quickshell owns the reveal of these panels. Avoid a second compositor
+-- animation and let the fullscreen dismiss surfaces disappear immediately.
+hl.layer_rule({
+  name    = "tsukuyomi-popup-motion",
+  match   = { namespace = "^(ryoku-(dashboard|control|network|volume|bluetooth|battery|brightness|power-profile|tray|traymenu|workspace|cpu|memory|gpu|thermals|storage|ai-usage|mpris|plugin-panel|dock-menu|sidebar-left|corner-dismiss|qsbar-tooltip|image-carousel(-cr|-hs)?|media-browser(-hs)?|media-carousel)|quickshell(-popup-dismiss|:dock-dismiss))$" },
+  no_anim = true,
+})
