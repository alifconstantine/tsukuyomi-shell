{
  "barStyle": "qsbar",
  "launcherTarget": "quick",
  "general": {
    "clock_format_24_h": true
  },
  "qsbar": {
    "barShellStyle": "islands",
    "barPosition": "top",
    "barFrostEnabled": true,
    "barColor": "foreground",
    "barAnim": 0,
    "barGapTop": 6,
    "barCornerRadius": 16,
    "launcherLogoMode": "icon",
    "workspaceMode": "5",
    "workspaceStyle": "default",
    "layout": {
      "version": 1,
      "left": ["launcher", "workspaces"],
      "center": ["clock"],
      "right": ["quick", "network", "volume", "memory", "battery", "brightness"]
    },
    "widgets": {
      "quick": true,
      "network": true,
      "volume": true,
      "battery": true,
      "brightness": true,
      "status": false,
      "memory": true,
      "cpu": false,
      "weather": false,
      "media": false,
      "mpris": false,
      "claude": false,
      "power": false,
      "bluetooth": false,
      "gpu": false,
      "cpuTemperature": false,
      "storage": false,
      "layout": false
    }
  },
  "dock": {
    "enabled": true,
    "edge": "bottom",
    "style": "rail",
    "frost": true,
    "autohide": true,
    "revealOnEmpty": true,
    "magnify": true,
    "labels": true
  },
  "theme": {
    "theme": "Default",
    "matugen": {
      "mode": "Dark",
      "preference": "Darkness"
    }
  }
}
